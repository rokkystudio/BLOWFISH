Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\*\shell\Blowfish]
"MUIVerb"="Blowfish"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\*\shell\Blowfish\shell\Encrypt]
"MUIVerb"="Encrypt"

[HKEY_CURRENT_USER\Software\Classes\*\shell\Blowfish\shell\Encrypt\command]
@="\"C:\\Program Files\\BlowfishTool\\BlowfishTool.exe\" --shell-encrypt \"%1\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\Blowfish\shell\Decrypt]
"MUIVerb"="Decrypt"

[HKEY_CURRENT_USER\Software\Classes\*\shell\Blowfish\shell\Decrypt\command]
@="\"C:\\Program Files\\BlowfishTool\\BlowfishTool.exe\" --shell-decrypt \"%1\""